#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

STATE="/etc/korobka/support/state.json"
RUNNER="/usr/local/sbin/korobka-support-run"

start_service() {
    [ -x "$RUNNER" ] || return 1
    [ -s "$STATE" ] || return 0

    enabled="$(jq -r '.enabled // false' "$STATE" 2>/dev/null || echo false)"
    expires="$(jq -r '.expires_at // 0' "$STATE" 2>/dev/null || echo 0)"
    now="$(date +%s)"

    [ "$enabled" = true ] || return 0
    if [ "$expires" -le "$now" ]; then
        /usr/bin/korobka-support expire-cleanup >/dev/null 2>&1 || true
        return 0
    fi

    procd_open_instance
    procd_set_param command "$RUNNER"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 5
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger korobka
}
